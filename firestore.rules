rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Organizations
    match /organizations/{orgId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /{subcollection=**} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }
  }
}
